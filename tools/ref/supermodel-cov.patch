+// PPCCoverage: measurement hooks for the VF3 recomp study (not part of upstream Supermodel).
+// See PPCCoverage.h. Output goes to $SM_COV_DIR at exit: summary.txt plus raw files for merging.
+#include "PPCCoverage.h"
+#include "Supermodel.h"
+#include "PPCDisasm.h"
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+#include <map>
+#include <unordered_map>
+#include <algorithm>
+
+extern void ppc_cov_state(UINT32 *s);
+
+namespace PPCCov
+{
+  bool on = false;
+  uint64_t *ramCount = nullptr;
+  uint64_t *romCount = nullptr;
+  uint8_t  *ramDirty = nullptr;
+
+  static const uint32_t RAM_WORDS = 0x00800000 / 4;
+  static const uint32_t ROM_WORDS = 0x00800000 / 4;
+  static const uint32_t NO_WRITER = 0xFFFFFFFF;
+
+  static std::string s_dir;
+  static const uint8_t *s_ram = nullptr;
+  static const uint8_t *s_crom = nullptr;   // fixed 8 MB at 0xFF800000, banked CROM after it
+  static uint32_t s_cromBytes = 0;
+
+  static uint32_t *s_firstOp = nullptr;     // opcode seen the first time each RAM word ran
+  static uint32_t *s_lastWriter = nullptr;  // PC of the last store to each RAM word
+  static uint32_t *s_lastWriteFrame = nullptr;
+  static uint32_t *s_firstExecFrame = nullptr;
+  static uint8_t  *s_ramFlags = nullptr;    // 1 ran, 2 call target, 4 indirect target, 8 ran modified, 16 interrupt entry
+  static uint8_t  *s_romFlags = nullptr;
+  static uint64_t s_frame = 0;
+  static uint64_t s_uniqueRam = 0, s_uniqueOther = 0;
+  static uint64_t s_resets = 0;
+
+  struct Loader { uint64_t words = 0; uint32_t lo = 0xFFFFFFFF, hi = 0; uint32_t f0 = 0xFFFFFFFF, f1 = 0; };
+  static std::map<uint32_t, Loader> s_loaders;         // writer PC of code that later ran
+
+  struct SmcWriter { uint64_t writes = 0, changed = 0; uint32_t lo = 0xFFFFFFFF, hi = 0; uint64_t f0 = ~0ull, f1 = 0; };
+  static std::map<uint32_t, SmcWriter> s_smcWriters;   // stores that landed on code already run
+  struct SmcEvent { uint64_t frame; uint32_t addr, writer, oldw, neww; };
+  static std::vector<SmcEvent> s_smcEvents;            // first changed-value events, for local inspection
+
+  struct ModExec { uint64_t count = 0; uint64_t f0 = ~0ull, f1 = 0; std::vector<uint32_t> ops; };
+  static std::map<uint32_t, ModExec> s_modExec;        // code that ran with a different opcode than before
+  static uint64_t s_rewrittenSameExec = 0;
+
+  struct Edge { uint8_t kind; uint64_t count; };
+  enum { K_BCCTR, K_BCCTRL, K_BLR_JUMP, K_BLRL, K_RFI, K_EXC_OP, K_ASYNC, K_COUNT };
+  static const char *s_kindName[K_COUNT] = { "bcctr", "bcctrl", "blr-not-return", "bclrl", "rfi", "exception-in-op", "interrupt" };
+  static std::unordered_map<uint64_t, Edge> s_edges;
+  static std::unordered_map<uint32_t, uint64_t> s_calls;  // direct and indirect call targets
+  static uint64_t s_returns = 0;
+
+  // I/O: every access outside RAM and CROM, by address, size and direction
+  struct IoRec { uint64_t count = 0; uint64_t f0 = ~0ull, f1 = 0; uint64_t values[6]; int nvalues = 0; bool more = false; };
+  static std::unordered_map<uint64_t, IoRec> s_io;
+  static FILE *s_stateFile = nullptr;
+
+  void Io(uint32_t addr, int bits, bool write, uint64_t value)
+  {
+    IoRec &r = s_io[((uint64_t)addr << 8) | ((uint64_t)bits << 1) | (write ? 1 : 0)];
+    r.count++;
+    r.f0 = std::min(r.f0, s_frame);
+    r.f1 = std::max(r.f1, s_frame);
+    for (int i = 0; i < r.nvalues; i++)
+      if (r.values[i] == value)
+        return;
+    if (r.nvalues < 6)
+      r.values[r.nvalues++] = value;
+    else
+      r.more = true;
+  }
+
+  struct MarkRec { std::string name; uint64_t frame, ram, rom; };
+  static std::vector<MarkRec> s_marks;
+
+  static uint64_t RomUnique()
+  {
+    uint64_t n = 0;
+    for (uint32_t i = 0; i < ROM_WORDS; i++)
+      n += romCount[i] != 0;
+    return n;
+  }
+
+  uint64_t FrameNumber() { return s_frame; }
+
+  void Init(const uint8_t *ram, const uint8_t *crom, uint32_t cromBytes)
+  {
+    const char *dir = getenv("SM_COV_DIR");
+    if (!dir || !*dir)
+      return;
+    s_dir = dir;
+    s_ram = ram;
+    s_crom = crom;
+    s_cromBytes = cromBytes;
+    if (!ramCount)
+    {
+      ramCount = new uint64_t[RAM_WORDS]();
+      romCount = new uint64_t[ROM_WORDS]();
+      ramDirty = new uint8_t[RAM_WORDS]();
+      s_firstOp = new uint32_t[RAM_WORDS]();
+      s_lastWriter = new uint32_t[RAM_WORDS];
+      s_lastWriteFrame = new uint32_t[RAM_WORDS]();
+      s_firstExecFrame = new uint32_t[RAM_WORDS]();
+      s_ramFlags = new uint8_t[RAM_WORDS]();
+      s_romFlags = new uint8_t[ROM_WORDS]();
+      std::fill(s_lastWriter, s_lastWriter + RAM_WORDS, NO_WRITER);
+    }
+    on = true;
+    fprintf(stderr, "[cov] PowerPC coverage on, output to %s\n", s_dir.c_str());
+  }
+
+  void Reset()
+  {
+    if (!on)
+      return;
+    // RAM is cleared on reset: forget what was written, keep what ran
+    s_resets++;
+    std::fill(s_lastWriter, s_lastWriter + RAM_WORDS, NO_WRITER);
+  }
+
+  void FirstRam(uint32_t pc, uint32_t op)
+  {
+    uint32_t i = pc >> 2;
+    s_uniqueRam++;
+    s_firstOp[i] = op;
+    s_ramFlags[i] |= 1;
+    s_firstExecFrame[i] = (uint32_t)s_frame;
+    ramDirty[i] = 0;
+    Loader &l = s_loaders[s_lastWriter[i]];
+    l.words++;
+    l.lo = std::min(l.lo, pc);
+    l.hi = std::max(l.hi, pc);
+    l.f0 = std::min(l.f0, s_lastWriteFrame[i]);
+    l.f1 = std::max(l.f1, s_lastWriteFrame[i]);
+  }
+
+  void DirtyExec(uint32_t pc, uint32_t op)
+  {
+    uint32_t i = pc >> 2;
+    ramDirty[i] = 0;
+    if (op == s_firstOp[i])
+    {
+      s_rewrittenSameExec++;
+      return;
+    }
+    s_ramFlags[i] |= 8;
+    ModExec &m = s_modExec[pc];
+    m.count++;
+    m.f0 = std::min(m.f0, s_frame);
+    m.f1 = std::max(m.f1, s_frame);
+    if (m.ops.size() < 4 && std::find(m.ops.begin(), m.ops.end(), op) == m.ops.end())
+      m.ops.push_back(op);
+  }
+
+  void OtherExec(uint32_t pc, uint32_t op)
+  {
+    static uint32_t lastReported = 0;
+    s_uniqueOther++;
+    if (pc != lastReported)
+      fprintf(stderr, "[cov] code ran outside RAM and fixed CROM: %08X\n", pc);
+    lastReported = pc;
+  }
+
+  static void AddEdge(uint8_t kind, uint32_t src, uint32_t dst)
+  {
+    uint64_t key = ((uint64_t)src << 32) | dst;
+    auto it = s_edges.find(key);
+    if (it == s_edges.end())
+      s_edges.emplace(key, Edge{ kind, 1 });
+    else
+      it->second.count++;
+    uint8_t flag = kind == K_ASYNC ? 16 : 4;
+    if (dst < 0x00800000)
+      s_ramFlags[dst >> 2] |= flag;
+    else if (dst >= 0xFF800000)
+      s_romFlags[(dst - 0xFF800000) >> 2] |= flag;
+  }
+
+  static void AddCall(uint32_t dst)
+  {
+    s_calls[dst]++;
+    if (dst < 0x00800000)
+      s_ramFlags[dst >> 2] |= 2;
+    else if (dst >= 0xFF800000)
+      s_romFlags[(dst - 0xFF800000) >> 2] |= 2;
+  }
+
+  static uint32_t WordAt(uint32_t addr)
+  {
+    if (addr < 0x00800000)
+      return *(const uint32_t *)&s_ram[addr];
+    if (addr >= 0xFF800000)
+      return *(const uint32_t *)&s_crom[addr - 0xFF800000];
+    return 0;
+  }
+
+  static bool IsLinkBranch(uint32_t op)
+  {
+    uint32_t p = op >> 26;
+    if ((op & 1) == 0)
+      return false;
+    if (p == 18 || p == 16)
+      return true;
+    if (p == 19)
+    {
+      uint32_t x = (op >> 1) & 0x3FF;
+      return x == 16 || x == 528;
+    }
+    return false;
+  }
+
+  void Flow(uint32_t pc, uint32_t op, uint32_t npc)
+  {
+    uint32_t p = op >> 26;
+    bool lk = op & 1;
+    if (p == 18 || p == 16)
+    {
+      if (lk)
+        AddCall(npc);
+      return;
+    }
+    if (p == 19)
+    {
+      uint32_t x = (op >> 1) & 0x3FF;
+      if (x == 528)
+      {
+        AddEdge(lk ? K_BCCTRL : K_BCCTR, pc, npc);
+        if (lk)
+          AddCall(npc);
+        return;
+      }
+      if (x == 16)
+      {
+        if (lk)
+        {
+          AddEdge(K_BLRL, pc, npc);
+          AddCall(npc);
+          return;
+        }
+        // A return lands just after a branch-and-link; anything else is a jump through LR
+        if (IsLinkBranch(WordAt(npc - 4)))
+          s_returns++;
+        else
+          AddEdge(K_BLR_JUMP, pc, npc);
+        return;
+      }
+      if (x == 50)
+      {
+        AddEdge(K_RFI, pc, npc);
+        return;
+      }
+    }
+    AddEdge(K_EXC_OP, pc, npc);
+  }
+
+  void Async(uint32_t from, uint32_t to)
+  {
+    AddEdge(K_ASYNC, from, to);
+  }
+
+  void RamWrite(uint32_t addr, uint32_t oldWord, uint32_t newWord, uint32_t writerPC)
+  {
+    uint32_t i = addr >> 2;
+    s_lastWriter[i] = writerPC;
+    s_lastWriteFrame[i] = (uint32_t)s_frame;
+    if (ramCount[i] == 0)
+      return;
+    ramDirty[i] = 1;
+    SmcWriter &w = s_smcWriters[writerPC];
+    w.writes++;
+    w.lo = std::min(w.lo, addr);
+    w.hi = std::max(w.hi, addr);
+    w.f0 = std::min(w.f0, s_frame);
+    w.f1 = std::max(w.f1, s_frame);
+    if (oldWord != newWord)
+    {
+      w.changed++;
+      if (s_smcEvents.size() < 4096)
+        s_smcEvents.push_back(SmcEvent{ s_frame, addr, writerPC, oldWord, newWord });
+    }
+  }
+
+  // Per frame (SM_STATE=<file>): the CPU state and a hash of RAM, 128 words a frame, for lockstep checks
+  void Frame()
+  {
+    s_frame++;
+    if (!on)
+      return;
+    if (!s_stateFile)
+    {
+      const char *path = getenv("SM_STATE");
+      if (!path)
+        return;
+      s_stateFile = fopen(path, "wb");
+      if (!s_stateFile)
+        return;
+    }
+    UINT32 s[128] = {};
+    ppc_cov_state(s);
+    uint64_t h = 1469598103934665603ull;   // FNV-1a over the RAM words
+    const uint32_t *w = (const uint32_t *)s_ram;
+    for (uint32_t i = 0; i < RAM_WORDS; i++)
+      h = (h ^ w[i]) * 1099511628211ull;
+    s[114] = (uint32_t)(h >> 32);
+    s[115] = (uint32_t)h;
+    s[116] = (uint32_t)s_frame;
+    fwrite(s, 4, 128, s_stateFile);
+    // SM_RAM_AT=<frame>: RAM as it is after that frame, for finding what differs
+    static long ramAt = getenv("SM_RAM_AT") ? atol(getenv("SM_RAM_AT")) : -1;
+    if ((long)s_frame == ramAt)
+    {
+      std::string p = s_dir + "/ram_" + std::to_string(s_frame) + ".bin";
+      if (FILE *f = fopen(p.c_str(), "wb")) { fwrite(s_ram, 1, RAM_WORDS * 4, f); fclose(f); }
+    }
+  }
+
+  void Mark(const char *name)
+  {
+    if (!on)
+      return;
+    s_marks.push_back(MarkRec{ name, s_frame, s_uniqueRam, RomUnique() });
+    fprintf(stderr, "[cov] mark %s at frame %llu: %llu RAM instructions so far\n", name, (unsigned long long)s_frame,
+            (unsigned long long)s_uniqueRam);
+  }
+
+  // Coalesced runs of executed words
+  static void WriteRanges(FILE *f, const uint64_t *count, uint32_t words, uint32_t base, uint32_t *runs, uint32_t *lo, uint32_t *hi)
+  {
+    *runs = 0; *lo = 0xFFFFFFFF; *hi = 0;
+    uint32_t i = 0;
+    while (i < words)
+    {
+      if (!count[i]) { i++; continue; }
+      uint32_t s = i;
+      while (i < words && count[i]) i++;
+      if (f)
+        fprintf(f, "%08X %08X %u\n", base + s * 4, base + i * 4 - 4, i - s);
+      (*runs)++;
+      *lo = std::min(*lo, base + s * 4);
+      *hi = std::max(*hi, base + i * 4 - 4);
+    }
+  }
+
+  static FILE *Open(const char *name)
+  {
+    std::string p = s_dir + "/" + name;
+    FILE *f = fopen(p.c_str(), "w");
+    if (!f)
+      fprintf(stderr, "[cov] can't write %s\n", p.c_str());
+    return f;
+  }
+
+  // Where in CROM (fixed + banked) does the RAM code come from? Looks for the first run of 16 executed
+  // words, then compares every executed RAM word with the CROM image at that offset.
+  static void CompareWithRom(FILE *f)
+  {
+    uint32_t start = 0;
+    bool found = false;
+    for (uint32_t i = 0; i + 16 < RAM_WORDS && !found; i++)
+    {
+      uint32_t k = 0;
+      while (k < 16 && ramCount[i + k]) k++;
+      if (k == 16 && s_firstOp[i] != 0) { start = i; found = true; }
+    }
+    if (!found)
+    {
+      fprintf(f, "rom image: no run of 16 executed RAM words\n");
+      return;
+    }
+    uint32_t key[16];
+    for (int k = 0; k < 16; k++)
+      key[k] = s_firstOp[start + k];
+    std::vector<uint32_t> hits;
+    for (uint32_t off = 0; off + 64 <= s_cromBytes; off += 4)
+      if (memcmp(&s_crom[off], key, 64) == 0)
+        hits.push_back(off);
+    fprintf(f, "rom image: RAM %08X found at %zu CROM offset(s)", start * 4, hits.size());
+    for (size_t h = 0; h < hits.size() && h < 4; h++)
+      fprintf(f, " %s+%07X", hits[h] < 0x800000 ? "fixed" : "banked", hits[h] < 0x800000 ? hits[h] : hits[h] - 0x800000);
+    fprintf(f, "\n");
+    if (hits.empty())
+      return;
+    // RAM address A came from CROM byte offset base + A
+    int64_t base = (int64_t)hits[0] - (int64_t)start * 4;
+    fprintf(f, "rom image: RAM 0 corresponds to CROM offset %s0x%llX (fixed CROM starts at 0xFF800000)\n",
+            base < 0 ? "-" : "", (unsigned long long)(base < 0 ? -base : base));
+    uint64_t same = 0, differ = 0, outside = 0;
+    std::vector<uint32_t> diffs;
+    for (uint32_t i = 0; i < RAM_WORDS; i++)
+    {
+      if (!ramCount[i]) continue;
+      int64_t off = base + (int64_t)i * 4;
+      if (off < 0 || off + 4 > (int64_t)s_cromBytes) { outside++; continue; }
+      if (*(const uint32_t *)&s_crom[off] == s_firstOp[i]) same++;
+      else { differ++; if (diffs.size() < 64) diffs.push_back(i * 4); }
+    }
+    fprintf(f, "rom image: executed RAM words identical to the CROM image %llu, different %llu, beyond the image %llu\n",
+            (unsigned long long)same, (unsigned long long)differ, (unsigned long long)outside);
+    for (uint32_t a : diffs)
+      fprintf(f, "  differs at RAM %08X (first ran frame %u, written by %08X)\n", a, s_firstExecFrame[a >> 2], s_lastWriter[a >> 2]);
+  }
+
+  struct OpStat { uint64_t statics = 0, dynamic = 0; };
+
+  static void OpStats(FILE *f)
+  {
+    std::map<std::string, OpStat> stats;
+    char mnem[64], oprs[128];
+    auto add = [&](uint32_t op, uint32_t pc, uint64_t count)
+    {
+      std::string m;
+      if (DisassemblePowerPC(op, pc, mnem, oprs, sizeof(oprs), false) == Result::OKAY)
+        m = mnem;
+      else
+        m = "(invalid)";
+      OpStat &s = stats[m];
+      s.statics++;
+      s.dynamic += count;
+    };
+    for (uint32_t i = 0; i < RAM_WORDS; i++)
+      if (ramCount[i]) add(s_firstOp[i], i * 4, ramCount[i]);
+    for (uint32_t i = 0; i < ROM_WORDS; i++)
+      if (romCount[i]) add(*(const uint32_t *)&s_crom[i * 4], 0xFF800000 + i * 4, romCount[i]);
+    std::vector<std::pair<std::string, OpStat>> v(stats.begin(), stats.end());
+    std::sort(v.begin(), v.end(), [](auto &a, auto &b) { return a.second.dynamic > b.second.dynamic; });
+    fprintf(f, "# mnemonic static_count dynamic_count\n");
+    for (auto &e : v)
+      fprintf(f, "%-10s %8llu %14llu\n", e.first.c_str(), (unsigned long long)e.second.statics, (unsigned long long)e.second.dynamic);
+  }
+
+  void Dump()
+  {
+    if (!on)
+      return;
+    on = false;
+    uint64_t romUnique = RomUnique();
+
+    FILE *f = Open("cov_ram.txt");
+    uint32_t ramRuns, ramLo, ramHi, romRuns, romLo, romHi;
+    WriteRanges(f, ramCount, RAM_WORDS, 0, &ramRuns, &ramLo, &ramHi);
+    if (f) fclose(f);
+    f = Open("cov_rom.txt");
+    WriteRanges(f, romCount, ROM_WORDS, 0xFF800000, &romRuns, &romLo, &romHi);
+    if (f) fclose(f);
+
+    for (uint32_t i = 0; i < ROM_WORDS; i++)
+      if (romCount[i])
+        s_romFlags[i] |= 1;
+    if ((f = Open("flags_ram.bin"))) { fwrite(s_ramFlags, 1, RAM_WORDS, f); fclose(f); }
+    if ((f = Open("flags_rom.bin"))) { fwrite(s_romFlags, 1, ROM_WORDS, f); fclose(f); }
+
+    if ((f = Open("indirect.txt")))
+    {
+      fprintf(f, "# kind src dst count\n");
+      std::vector<std::pair<uint64_t, Edge>> v(s_edges.begin(), s_edges.end());
+      std::sort(v.begin(), v.end(), [](auto &a, auto &b) { return a.first < b.first; });
+      for (auto &e : v)
+        fprintf(f, "%s %08X %08X %llu\n", s_kindName[e.second.kind], (uint32_t)(e.first >> 32), (uint32_t)e.first, (unsigned long long)e.second.count);
+      fclose(f);
+    }
+    if ((f = Open("calls.txt")))
+    {
+      std::vector<std::pair<uint32_t, uint64_t>> v(s_calls.begin(), s_calls.end());
+      std::sort(v.begin(), v.end());
+      for (auto &e : v)
+        fprintf(f, "%08X %llu\n", e.first, (unsigned long long)e.second);
+      fclose(f);
+    }
+    if ((f = Open("smc_events.txt")))
+    {
+      fprintf(f, "# frame addr writer old new (first %zu changed-value stores onto code that had run)\n", s_smcEvents.size());
+      for (auto &e : s_smcEvents)
+        fprintf(f, "%llu %08X %08X %08X %08X\n", (unsigned long long)e.frame, e.addr, e.writer, e.oldw, e.neww);
+      fclose(f);
+    }
+    if ((f = Open("hot.txt")))
+    {
+      std::vector<std::pair<uint64_t, uint32_t>> v;
+      for (uint32_t i = 0; i < RAM_WORDS; i++) if (ramCount[i]) v.push_back({ ramCount[i], i * 4 });
+      for (uint32_t i = 0; i < ROM_WORDS; i++) if (romCount[i]) v.push_back({ romCount[i], 0xFF800000 + i * 4 });
+      std::sort(v.begin(), v.end(), [](auto &a, auto &b) { return a.first > b.first; });
+      for (size_t k = 0; k < v.size() && k < 500; k++)
+        fprintf(f, "%08X %llu\n", v[k].second, (unsigned long long)v[k].first);
+      fclose(f);
+    }
+    if ((f = Open("opstats.txt"))) { OpStats(f); fclose(f); }
+    if ((f = Open("io.txt")))
+    {
+      fprintf(f, "# addr bits r/w count first_frame last_frame values\n");
+      std::vector<std::pair<uint64_t, IoRec>> v(s_io.begin(), s_io.end());
+      std::sort(v.begin(), v.end(), [](auto &a, auto &b) { return a.first < b.first; });
+      for (auto &e : v)
+      {
+        fprintf(f, "%08X %2u %c %10llu %7llu %7llu", (uint32_t)(e.first >> 8), (unsigned)((e.first >> 1) & 0x7F),
+                (e.first & 1) ? 'w' : 'r', (unsigned long long)e.second.count, (unsigned long long)e.second.f0,
+                (unsigned long long)e.second.f1);
+        for (int i = 0; i < e.second.nvalues; i++)
+          fprintf(f, " %llX", (unsigned long long)e.second.values[i]);
+        fprintf(f, "%s\n", e.second.more ? " ..." : "");
+      }
+      fclose(f);
+    }
+    if (s_stateFile)
+      fclose(s_stateFile);
+
+    f = Open("summary.txt");
+    if (!f)
+      return;
+    uint64_t dynRam = 0, dynRom = 0;
+    for (uint32_t i = 0; i < RAM_WORDS; i++) dynRam += ramCount[i];
+    for (uint32_t i = 0; i < ROM_WORDS; i++) dynRom += romCount[i];
+    fprintf(f, "frames %llu\nresets %llu\n", (unsigned long long)s_frame, (unsigned long long)s_resets);
+    fprintf(f, "instructions executed: RAM %llu, CROM %llu\n", (unsigned long long)dynRam, (unsigned long long)dynRom);
+    fprintf(f, "unique instructions: RAM %llu in %u runs (%08X-%08X), CROM %llu in %u runs (%08X-%08X), elsewhere %llu\n",
+            (unsigned long long)s_uniqueRam, ramRuns, ramLo, ramHi, (unsigned long long)romUnique, romRuns, romLo, romHi,
+            (unsigned long long)s_uniqueOther);
+    CompareWithRom(f);
+
+    fprintf(f, "\nwho wrote the RAM code that ran (writer PC, words, address range, frames written):\n");
+    for (auto &l : s_loaders)
+    {
+      char who[32];
+      if (l.first == NO_WRITER)
+        snprintf(who, sizeof(who), "never-written");
+      else
+        snprintf(who, sizeof(who), "pc %08X", l.first);
+      fprintf(f, "  %s %llu words %08X-%08X frames %u-%u\n", who, (unsigned long long)l.second.words, l.second.lo,
+              l.second.hi, l.second.f0, l.second.f1);
+    }
+
+    uint64_t smcWrites = 0, smcChanged = 0;
+    for (auto &w : s_smcWriters) { smcWrites += w.second.writes; smcChanged += w.second.changed; }
+    fprintf(f, "\nstores onto code that had already run: %llu (%llu changed the word) from %zu store PCs\n",
+            (unsigned long long)smcWrites, (unsigned long long)smcChanged, s_smcWriters.size());
+    for (auto &w : s_smcWriters)
+      fprintf(f, "  writer %08X: %llu stores, %llu changed, addresses %08X-%08X, frames %llu-%llu\n", w.first,
+              (unsigned long long)w.second.writes, (unsigned long long)w.second.changed, w.second.lo, w.second.hi,
+              (unsigned long long)w.second.f0, (unsigned long long)w.second.f1);
+    fprintf(f, "rewritten code that ran again with the same word: %llu times\n", (unsigned long long)s_rewrittenSameExec);
+    fprintf(f, "code that ran again with a different word: %zu addresses\n", s_modExec.size());
+    for (auto &m : s_modExec)
+      fprintf(f, "  %08X ran %llu times modified, frames %llu-%llu, %zu distinct new words\n", m.first,
+              (unsigned long long)m.second.count, (unsigned long long)m.second.f0, (unsigned long long)m.second.f1, m.second.ops.size());
+
+    uint64_t kindEdges[K_COUNT] = {}, kindCount[K_COUNT] = {};
+    std::map<uint32_t, uint64_t> kindTargets[K_COUNT];
+    for (auto &e : s_edges)
+    {
+      kindEdges[e.second.kind]++;
+      kindCount[e.second.kind] += e.second.count;
+      kindTargets[e.second.kind][(uint32_t)e.first]++;
+    }
+    fprintf(f, "\ncontrol flow:\n  call targets %zu\n  returns %llu\n", s_calls.size(), (unsigned long long)s_returns);
+    for (int k = 0; k < K_COUNT; k++)
+      fprintf(f, "  %-16s %6llu distinct edges, %6zu distinct targets, %llu times\n", s_kindName[k], (unsigned long long)kindEdges[k],
+              kindTargets[k].size(), (unsigned long long)kindCount[k]);
+    fprintf(f, "  interrupt entries:");
+    for (auto &t : kindTargets[K_ASYNC])
+      fprintf(f, " %08X", t.first);
+    fprintf(f, "\n");
+
+    // Cache and sync instructions say whether the program expects to change code
+    const char *watch[] = { "icbi", "isync", "sync", "dcbf", "dcbst", "dcbi", "dcbz", "eieio", "mtmsr", "rfi", "sc", "tw", "twi", "lwarx", "stwcx." };
+    std::map<std::string, std::pair<uint64_t, uint64_t>> seen;
+    char mnem[64], oprs[128];
+    for (uint32_t i = 0; i < RAM_WORDS; i++)
+      if (ramCount[i] && DisassemblePowerPC(s_firstOp[i], i * 4, mnem, oprs, sizeof(oprs), false) == Result::OKAY)
+        for (const char *w : watch)
+          if (!strcmp(mnem, w)) { seen[w].first++; seen[w].second += ramCount[i]; }
+    for (uint32_t i = 0; i < ROM_WORDS; i++)
+      if (romCount[i] && DisassemblePowerPC(*(const uint32_t *)&s_crom[i * 4], 0xFF800000 + i * 4, mnem, oprs, sizeof(oprs), false) == Result::OKAY)
+        for (const char *w : watch)
+          if (!strcmp(mnem, w)) { seen[w].first++; seen[w].second += romCount[i]; }
+    fprintf(f, "\ncache, sync and system instructions run (static, dynamic):\n");
+    for (const char *w : watch)
+      fprintf(f, "  %-7s %6llu %12llu\n", w, (unsigned long long)seen[w].first, (unsigned long long)seen[w].second);
+
+    fprintf(f, "\nmarks (frame, unique RAM instructions, unique CROM instructions):\n");
+    for (auto &m : s_marks)
+      fprintf(f, "  %-24s %8llu %8llu %8llu\n", m.name.c_str(), (unsigned long long)m.frame, (unsigned long long)m.ram, (unsigned long long)m.rom);
+    fprintf(f, "  %-24s %8llu %8llu %8llu\n", "(end)", (unsigned long long)s_frame, (unsigned long long)s_uniqueRam, (unsigned long long)romUnique);
+    fclose(f);
+    fprintf(stderr, "[cov] wrote %s/summary.txt\n", s_dir.c_str());
+  }
+}
diff --git a/Src/CPU/PowerPC/PPCCoverage.h b/Src/CPU/PowerPC/PPCCoverage.h
new file mode 100644
index 0000000..7cbffca
--- /dev/null
+++ b/Src/CPU/PowerPC/PPCCoverage.h
@@ -0,0 +1,50 @@
+// PPCCoverage: measurement hooks for the VF3 recomp study (not part of upstream Supermodel).
+// Records which PowerPC instructions run, the indirect control flow, and every write to RAM
+// that lands on code already run (self-modifying code). Enabled by SM_COV_DIR=<folder>.
+#pragma once
+#include <cstdint>
+
+namespace PPCCov
+{
+  extern bool on;
+  extern uint64_t *ramCount;    // per RAM word (8 MB / 4)
+  extern uint64_t *romCount;    // per fixed CROM word (0xFF800000-0xFFFFFFFF)
+  extern uint8_t  *ramDirty;    // word written since it last ran
+
+  void Init(const uint8_t *ram, const uint8_t *crom, uint32_t cromBytes);
+  void FirstRam(uint32_t pc, uint32_t op);
+  void DirtyExec(uint32_t pc, uint32_t op);
+  void OtherExec(uint32_t pc, uint32_t op);
+  void Flow(uint32_t pc, uint32_t op, uint32_t npc);
+  void Async(uint32_t from, uint32_t to);
+  void RamWrite(uint32_t addr, uint32_t oldWord, uint32_t newWord, uint32_t writerPC);
+  void Reset();
+  void Io(uint32_t addr, int bits, bool write, uint64_t value);
+  void Frame();
+  void Mark(const char *name);
+  void Dump();
+  uint64_t FrameNumber();
+
+  inline void Exec(uint32_t pc, uint32_t op)
+  {
+    if (pc < 0x00800000)
+    {
+      uint32_t i = pc >> 2;
+      if (ramCount[i]++ == 0)
+        FirstRam(pc, op);
+      else if (ramDirty[i])
+        DirtyExec(pc, op);
+    }
+    else if (pc >= 0xFF800000)
+      romCount[(pc - 0xFF800000) >> 2]++;
+    else
+      OtherExec(pc, op);
+  }
+
+  // Called from the RAM write paths with the aligned word before and after the write
+  inline void RamWritten(uint32_t wordAddr, uint32_t oldWord, uint32_t newWord, uint32_t writerPC)
+  {
+    if (on)
+      RamWrite(wordAddr, oldWord, newWord, writerPC);
+  }
+}
