+// PPCCoverage: the CPU state at the end of each frame, for comparing other implementations against this one
+void ppc_cov_state(UINT32 *s)
+{
+	for (int i = 0; i < 32; i++) s[i] = ppc.r[i];
+	for (int i = 0; i < 32; i++) { s[32 + 2 * i] = (UINT32)(ppc.fpr[i].id >> 32); s[33 + 2 * i] = (UINT32)ppc.fpr[i].id; }
+	UINT32 cr = 0;
+	for (int i = 0; i < 8; i++) cr = (cr << 4) | (ppc.cr[i] & 0xF);
+	s[96] = cr; s[97] = ppc.xer; s[98] = ppc.lr; s[99] = ppc.ctr; s[100] = ppc.msr; s[101] = ppc.npc;
+	s[102] = ppc.srr0; s[103] = ppc.srr1; s[104] = ppc.dec; s[105] = (UINT32)ppc.tb; s[106] = (UINT32)(ppc.tb >> 32);
+	s[107] = ppc.fpscr; for (int i = 0; i < 4; i++) s[108 + i] = ppc.sprg[i];
+	s[112] = ppc.hid0; s[113] = ppc.hid1; s[117] = ppc.interrupt_pending; s[118] = ppc.timer_frac;
+}
