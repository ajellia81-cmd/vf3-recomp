diff --git a/Src/OSD/SDL/InputScript.cpp b/Src/OSD/SDL/InputScript.cpp
new file mode 100644
index 0000000..033ddbf
--- /dev/null
+++ b/Src/OSD/SDL/InputScript.cpp
@@ -0,0 +1,214 @@
+// InputScript: scripted inputs for headless measurement runs (not part of upstream Supermodel).
+//
+// One command per line, '#' starts a comment. The frame is absolute, or +N after the previous line's frame.
+//   <frame> press <input> [frames]   hold for a number of frames (default 6), then release
+//   <frame> hold <input>             hold until released
+//   <frame> release <input>
+//   <frame> random <p1|p2> <seed>    random play (sticks and buttons) for that player; "random p1 off" stops
+//   <frame> mark <name>              coverage phase marker
+//   <frame> shot <name>              save a screenshot
+//   <frame> quit
+// Inputs: p1.coin p1.start p1.up p1.down p1.left p1.right p1.punch p1.kick p1.guard p1.escape, the same for p2,
+// and test, service.
+#include "InputScript.h"
+#include "Inputs/Inputs.h"
+#include "Inputs/Input.h"
+#include "CPU/PowerPC/PPCCoverage.h"
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cctype>
+#include <fstream>
+#include <sstream>
+#include <vector>
+#include <map>
+#include <memory>
+
+namespace InputScript
+{
+  struct Cmd
+  {
+    uint64_t frame;
+    std::string op, arg;
+    long n;
+  };
+
+  struct Random
+  {
+    bool on = false;
+    uint64_t state = 1;
+    uint64_t until = 0;
+    bool dir[4] = {}, btn[4] = {};
+  };
+
+  static std::vector<Cmd> s_cmds;
+  static size_t s_next = 0;
+  static bool s_active = false;
+  static std::map<std::string, uint64_t> s_held;   // input -> release frame (UINT64_MAX: until released)
+  static Random s_random[2];
+
+  static uint32_t Rand(Random &r)
+  {
+    r.state = r.state * 6364136223846793005ull + 1442695040888963407ull;
+    return (uint32_t)(r.state >> 33);
+  }
+
+  bool Load(const char *path)
+  {
+    std::ifstream in(path);
+    if (!in)
+    {
+      fprintf(stderr, "[script] can't read %s\n", path);
+      return false;
+    }
+    std::string line;
+    uint64_t prev = 0;
+    int lineNo = 0;
+    while (std::getline(in, line))
+    {
+      lineNo++;
+      size_t hash = line.find('#');
+      if (hash != std::string::npos)
+        line.resize(hash);
+      std::istringstream ss(line);
+      std::string when, op, arg, n;
+      if (!(ss >> when >> op))
+        continue;
+      ss >> arg >> n;
+      Cmd c;
+      c.frame = when[0] == '+' ? prev + strtoull(when.c_str() + 1, nullptr, 10) : strtoull(when.c_str(), nullptr, 10);
+      c.op = op;
+      c.arg = arg;
+      c.n = (n.empty() || !isdigit((unsigned char)n[0])) ? -1 : strtol(n.c_str(), nullptr, 0);
+      if (op != "press" && op != "hold" && op != "release" && op != "random" && op != "mark" && op != "shot" && op != "quit")
+      {
+        fprintf(stderr, "[script] %s:%d: unknown command '%s'\n", path, lineNo, op.c_str());
+        return false;
+      }
+      if (c.frame < prev)
+      {
+        fprintf(stderr, "[script] %s:%d: frame goes backwards\n", path, lineNo);
+        return false;
+      }
+      prev = c.frame;
+      s_cmds.push_back(c);
+    }
+    s_active = true;
+    fprintf(stderr, "[script] %zu commands from %s\n", s_cmds.size(), path);
+    return true;
+  }
+
+  bool Active()
+  {
+    return s_active;
+  }
+
+  static std::shared_ptr<CSwitchInput> Find(CInputs *in, const std::string &name)
+  {
+    if (name == "test") return in->test[0];
+    if (name == "service") return in->service[0];
+    if (name.size() < 4 || name[0] != 'p' || (name[1] != '1' && name[1] != '2') || name[2] != '.')
+      return nullptr;
+    int p = name[1] - '1';
+    std::string b = name.substr(3);
+    if (b == "coin") return in->coin[p];
+    if (b == "start") return in->start[p];
+    if (b == "up") return in->up[p];
+    if (b == "down") return in->down[p];
+    if (b == "left") return in->left[p];
+    if (b == "right") return in->right[p];
+    if (b == "punch") return in->punch[p];
+    if (b == "kick") return in->kick[p];
+    if (b == "guard") return in->guard[p];
+    if (b == "escape") return in->escape[p];
+    return nullptr;
+  }
+
+  static void Set(CInputs *in, const std::string &name, bool down)
+  {
+    auto s = Find(in, name);
+    if (!s)
+    {
+      fprintf(stderr, "[script] unknown input %s\n", name.c_str());
+      return;
+    }
+    s->prevValue = s->value;
+    s->value = down ? 1 : 0;
+  }
+
+  static void RandomStep(CInputs *in, int p, uint64_t frame)
+  {
+    Random &r = s_random[p];
+    if (frame >= r.until)
+    {
+      r.until = frame + 3 + Rand(r) % 18;
+      uint32_t d = Rand(r) % 12;          // 0-7 the eight directions, 8-11 neutral
+      static const int dx[8] = { 0, 1, 1, 1, 0, -1, -1, -1 }, dy[8] = { -1, -1, 0, 1, 1, 1, 0, -1 };
+      int x = d < 8 ? dx[d] : 0, y = d < 8 ? dy[d] : 0;
+      r.dir[0] = y < 0; r.dir[1] = y > 0; r.dir[2] = x < 0; r.dir[3] = x > 0;
+      r.btn[0] = Rand(r) % 100 < 35;      // punch
+      r.btn[1] = Rand(r) % 100 < 35;      // kick
+      r.btn[2] = Rand(r) % 100 < 25;      // guard
+      r.btn[3] = Rand(r) % 100 < 8;       // escape
+    }
+    std::string pre = p ? "p2." : "p1.";
+    static const char *dirs[4] = { "up", "down", "left", "right" }, *btns[4] = { "punch", "kick", "guard", "escape" };
+    for (int k = 0; k < 4; k++)
+    {
+      Set(in, pre + dirs[k], r.dir[k]);
+      Set(in, pre + btns[k], r.btn[k]);
+    }
+  }
+
+  Actions Step(CInputs *in, uint64_t frame)
+  {
+    Actions a;
+    if (!s_active)
+      return a;
+    for (auto it = s_held.begin(); it != s_held.end();)
+    {
+      if (frame >= it->second)
+      {
+        Set(in, it->first, false);
+        it = s_held.erase(it);
+      }
+      else
+        ++it;
+    }
+    for (int p = 0; p < 2; p++)
+      if (s_random[p].on)
+        RandomStep(in, p, frame);
+    while (s_next < s_cmds.size() && s_cmds[s_next].frame <= frame)
+    {
+      const Cmd &c = s_cmds[s_next++];
+      if (c.op == "press")
+        s_held[c.arg] = frame + (c.n > 0 ? c.n : 6);
+      else if (c.op == "hold")
+        s_held[c.arg] = UINT64_MAX;
+      else if (c.op == "release")
+      {
+        s_held.erase(c.arg);
+        Set(in, c.arg, false);
+      }
+      else if (c.op == "random")
+      {
+        int p = c.arg == "p2" ? 1 : 0;
+        s_random[p].on = c.n >= 0;   // "off" parses as no number
+        s_random[p].state = (uint64_t)c.n * 2654435761ull + 1;
+        s_random[p].until = 0;
+        if (!s_random[p].on)
+          for (const char *b : { "up", "down", "left", "right", "punch", "kick", "guard", "escape" })
+            Set(in, std::string(p ? "p2." : "p1.") + b, false);
+      }
+      else if (c.op == "mark")
+        PPCCov::Mark(c.arg.c_str());
+      else if (c.op == "shot")
+        a.shot = c.arg.empty() ? "shot" : c.arg;
+      else if (c.op == "quit")
+        a.quit = true;
+    }
+    for (auto &h : s_held)
+      Set(in, h.first, true);
+    return a;
+  }
+}
